{
  "manifest_version": 3,
  "name": "Heygen Flux Unlimited",
  "version": "1.1.0",
  "description": "Automates project render and auto-downloads the completed video directly from your logged-in HeyGen session with built-in 30-day device locking.",
  "author": "Hasnain Raza (DigiLearn Academy RYK)",
  "permissions": [
    "activeTab",
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://*.heygen.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.heygen.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}